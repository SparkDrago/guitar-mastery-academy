{
  "name": "guitar-mastery-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Guitar Mastery Academy: a structured, interactive electric guitar learning platform.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch --serve",
    "build": "node scripts/build.mjs --production",
    "preview": "node scripts/serve.mjs dist 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --import tsx scripts/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "ww2ogg-ts": "latest",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
